# syntax=docker/dockerfile:1

FROM lukemathwalker/cargo-chef:latest-rust-1.97.1 AS chef

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        pkg-config \
        libssl-dev \
        libsqlite3-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV PROTOC=/usr/bin/protoc

WORKDIR /build/anki

FROM chef AS planner

COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build

COPY --from=planner /build/anki/recipe.json recipe.json
RUN --mount=type=cache,id=anki-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=anki-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --locked --release --recipe-path recipe.json

COPY . .
RUN command -v protoc && protoc --version
RUN --mount=type=cache,id=anki-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=anki-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo build --locked --release -p anki-api-server \
    && cp target/release/anki-api-server /tmp/anki-api-server

FROM debian:12.4-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 anki \
    && mkdir -p /config \
    && chown -R anki:anki /config

COPY --from=build /tmp/anki-api-server /usr/local/bin/anki-api-server

USER anki
WORKDIR /config
ENV ANKI_API_HOST=0.0.0.0
ENV ANKI_API_PORT=8765

VOLUME /config
EXPOSE 8765

ENTRYPOINT ["/usr/local/bin/anki-api-server"]
