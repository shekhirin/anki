FROM rust:1.97.1-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        pkg-config \
        libssl-dev \
        libsqlite3-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV PROTOC=/usr/bin/protoc

WORKDIR /build/anki
COPY . .
RUN command -v protoc && protoc --version
RUN cargo build --release -p anki-api-server

FROM debian:12.4-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 anki \
    && mkdir -p /config \
    && chown -R anki:anki /config

COPY --from=build /build/anki/target/release/anki-api-server /usr/local/bin/anki-api-server

USER anki
WORKDIR /config
ENV ANKI_API_HOST=0.0.0.0
ENV ANKI_API_PORT=8765

VOLUME /config
EXPOSE 8765

ENTRYPOINT ["/usr/local/bin/anki-api-server"]
